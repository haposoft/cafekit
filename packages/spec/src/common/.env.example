# CafeKit / Global Environment Variables
# Priority: LOWEST (overridden by skills/.env and skill-specific .env)
# Scope: Project-wide configuration, global defaults
# Setup: Copy to .env and configure your keys

# ============================================
# AI/ML API Keys (Global Defaults)
# ============================================

# Google Gemini / AI Studio API key
# Required for cf:test Multimodal Visual checks
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for Visual AI Testing 
# Default: gemma-4-31b-it (Optimized for layout QA)
VISUAL_MODEL=gemma-4-31b-it

# ============================================
# Development & CI/CD
# ============================================
# NODE_ENV=development
# DEBUG=false
